{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat", "title": "Service ready", "id": 1,
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 0},
      "targets": [{"expr": "predmaint_service_ready", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []}
    },
    {
      "type": "stat", "title": "Prediction requests / second", "id": 2,
      "gridPos": {"h": 5, "w": 7, "x": 4, "y": 0},
      "targets": [{"expr": "sum(rate(predmaint_http_requests_total{path=\"/v1/predict\"}[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "type": "stat", "title": "5xx error rate", "id": 3,
      "gridPos": {"h": 5, "w": 6, "x": 11, "y": 0},
      "targets": [{"expr": "sum(rate(predmaint_http_requests_total{path=\"/v1/predict\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(predmaint_http_requests_total{path=\"/v1/predict\"}[5m])), 0.001)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "max": 1}, "overrides": []}
    },
    {
      "type": "stat", "title": "p95 latency", "id": 4,
      "gridPos": {"h": 5, "w": 7, "x": 17, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(predmaint_http_request_duration_seconds_bucket{path=\"/v1/predict\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "type": "timeseries", "title": "Request rate by status", "id": 5,
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 5},
      "targets": [{"expr": "sum by (status) (rate(predmaint_http_requests_total{path=\"/v1/predict\"}[1m]))", "legendFormat": "{{status}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "type": "timeseries", "title": "Prediction decisions", "id": 6,
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 5},
      "targets": [{"expr": "sum by (decision) (rate(predmaint_predictions_total[1m]))", "legendFormat": "{{decision}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "type": "timeseries", "title": "Latency percentiles", "id": 7,
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 14},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(predmaint_http_request_duration_seconds_bucket{path=\"/v1/predict\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(predmaint_http_request_duration_seconds_bucket{path=\"/v1/predict\"}[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(predmaint_http_request_duration_seconds_bucket{path=\"/v1/predict\"}[5m])))", "legendFormat": "p99", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    }
  ],
  "refresh": "5s", "schemaVersion": 41,
  "tags": ["predictive-maintenance", "mlops"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "timezone": "browser",
  "title": "Predictive Maintenance Service Overview",
  "uid": "predmaint-service", "version": 1
}
